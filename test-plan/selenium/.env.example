# Selenium Test Environment Configuration

# Application URLs
BASE_URL=http://localhost:8888
API_URL=http://localhost:8000

# Browser Configuration
# Options: chrome, firefox, edge
BROWSER=chrome

# Run tests without browser UI (true/false)
HEADLESS=false

# Wait times (seconds)
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20

# Test User Credentials
TEST_EMAIL=testuser@example.com
TEST_PASSWORD=Test@123456
TEST_USERNAME=testuser

# Admin Credentials
ADMIN_EMAIL=admin
ADMIN_PASSWORD=1234

# Screenshot on failure (true/false)
SCREENSHOT_ON_FAILURE=true

# Report directory
REPORT_DIR=reports
